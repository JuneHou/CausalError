def caesar_decrypt(ciphertext, shift=10):
    decrypted = ""
    for char in ciphertext:
        if char.isalpha():
            base = ord('A') if char.isupper() else ord('a')
            new_char = chr((ord(char) - base - shift) % 26 + base)
            decrypted += new_char
        else:
            decrypted += char
    return decrypted

